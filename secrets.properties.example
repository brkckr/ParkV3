# Copy this file to `secrets.properties` (git-ignored) and fill in your own values.
# Never commit secrets.properties.
#
# Google Maps SDK for Android key. Restrict it in Google Cloud Console to:
#   - Application restriction: Android apps -> package com.brkckr.parkv3 (+ your SHA-1)
#   - API restriction: Maps SDK for Android
# Without a key the app still works; the map view shows an explanation instead.
MAPS_API_KEY=
